{
  "name": "iot-honeypot-backend",
  "version": "1.0.0",
  "description": "Mini IoT Honeypot & Intrusion Monitor - Express API, detection engine and Socket.IO broadcaster",
  "private": true,
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
