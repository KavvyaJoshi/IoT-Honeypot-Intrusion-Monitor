# Copy to backend/.env and adjust. Never commit the real .env file.

NODE_ENV=development
# 0.0.0.0 = LAN device mode: the ESP8266 can reach the API, and so can anything else on the same
#   network that Windows Firewall lets through. Add only the narrow rule in docs/NETWORKING.md.
# 127.0.0.1 = laptop-only mode: the simulator works, the ESP8266 cannot connect.
HOST=0.0.0.0
PORT=4000
# Optional fixed URL shown on the Devices page. Leave unset: LAN IPs are detected automatically and
# follow you between the phone hotspot and college Wi-Fi.
# PUBLIC_BASE_URL=
# Set to true only when running behind a reverse proxy that sets X-Forwarded-For.
TRUST_PROXY=false

# Local MongoDB (no cloud database required). Credentials, if any, stay in this file only.
MONGODB_URI=mongodb://127.0.0.1:27017/iot_honeypot
MONGODB_CONNECT_RETRY_MS=5000

# Comma-separated browser origins allowed to call the API and open Socket.IO connections.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Also allow THIS laptop's own current LAN IPs on these dashboard ports (default: true in development,
# false otherwise). Never allows other hosts. Useful with `npm run dev -- --host`.
CORS_ALLOW_LAN_ORIGINS=true
LAN_FRONTEND_PORTS=5173,4173

# Shared secret the ESP8266 sends in the X-Device-Key header (min 16 chars).
# Generate one with: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
DEVICE_API_KEY=

# Token for admin actions in the dashboard (simulator, rule and settings changes), min 16 chars.
# Generate with the same command as above. Enter it in the dashboard's "Unlock admin" dialog.
ADMIN_TOKEN=

# Simulator defaults to enabled outside production. Set false to disable it entirely.
SIMULATOR_ENABLED=true

# HTTP API rate limits (requests per window, per client IP).
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_PUBLIC_MAX=600
RATE_LIMIT_DEVICE_MAX=240
RATE_LIMIT_SIMULATOR_MAX=60
# Tiny limit for the dashboard's API rate-limiter demonstration endpoint.
RATE_LIMIT_PROBE_WINDOW_MS=10000
RATE_LIMIT_PROBE_MAX=5

# debug | info | warn | error | silent
LOG_LEVEL=info
