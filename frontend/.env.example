# Copy to frontend/.env.local if you need to change these. Only VITE_* values reach the browser,
# so never put secrets here (the admin token is entered in the UI at runtime instead).

# Where the Vite dev server proxies /api and /socket.io (default http://localhost:4000).
VITE_BACKEND_PROXY_TARGET=http://localhost:4000

# Backend base URL for the browser. Leave EMPTY (recommended): the dashboard then calls /api on its
# own origin and the dev/preview server proxies it, so laptop IP changes need no edits here.
# Set it only to call the backend directly (e.g. http://localhost:4000, or a built dashboard served
# elsewhere); that dashboard origin must then be allowed by the backend's CORS settings.
VITE_API_BASE_URL=
